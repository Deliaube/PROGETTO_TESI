  <button onclick="updateSum('A')">
      <img src="icone/icon-a.svg" alt="Opzione A" class="icon-button">
  </button>
  <button onclick="updateSum('B')">
      <img src="icone/icon-b.svg" alt="Opzione B" class="icon-button">
